# ─── Database (MySQL) ───────────────────────────────────────────────
# Drizzle/mysql2 connection string
DATABASE_URL=mysql://user:password@localhost:3306/feed_watch

# ─── Server ─────────────────────────────────────────────────────────
PORT=3000
# Comma-separated origins allowed for the API (dev client runs on 5173)
CLIENT_ORIGIN=http://localhost:5173
# Protect the dashboard and tRPC API with browser-native HTTP Basic Auth.
# APP_USERNAME defaults to "admin" when omitted. Always set APP_PASSWORD on Railway.
APP_USERNAME=admin
APP_PASSWORD=

# ─── Analysis LLM ───────────────────────────────────────────────────
# Two ways to power auto-analysis. Pick ONE (manual mode needs neither):
#
# (A) Anthropic (Claude):
ANTHROPIC_API_KEY=
#
# (B) Any OpenAI-compatible endpoint — Groq (free tier) / OpenRouter /
#     DeepInfra / Together / local Ollama. Set all three:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile      # or e.g. qwen-2.5-32b
#
# Recommended split for an OpenAI-compatible DeepSeek endpoint:
# per-article filtering + digest map compression = Flash, final synthesis = Pro.
# (The web Settings page may override these values.)
# FILTER_MODEL=deepseek-v4-flash
# ANALYSIS_MODEL=deepseek-v4-pro
# DeepSeek V4 stage policy is automatic: filter/map/Flash fallback = thinking
# OFF, final Pro digest = thinking ON. Avoid a global thinking override here;
# per-call stage policy wins so Flash cannot accidentally become expensive.

# ─── Collection / scheduling ────────────────────────────────────────
# Day boundary + main digest hour (KST). Date D = [(D-1) HH:00, D HH:00).
# This run generates the boundary digest, sweeps the WHOLE day window, and
# refreshes the filter memo.
DIGEST_HOUR=7
# Second (midday) digest hour (KST). Splits the day window into two slots; may sit
# before OR after DIGEST_HOUR (e.g. boundary 07 + midday 17). Digest ONLY (no sweep).
DIGEST_MIDDAY_HOUR=17
# Digest synthesis output cap (tokens). Lower if the provider rejects it.
DIGEST_MAX_TOKENS=8192
# Final deepseek-v4-pro uses thinking by default. Set 0 only as an emergency
# cost/compatibility kill switch. Thinking + final prose share max_tokens, so
# the app raises the first Pro cap to at least this floor automatically.
DIGEST_PRO_THINKING=1
DIGEST_PRO_THINKING_TOKENS=24576
# If final Pro returns an empty/length-truncated answer, retry the SAME Pro once.
# In thinking mode the app enforces at least 2× the first-call budget, then and
# only then falls back to non-thinking Flash.
DIGEST_FINAL_RETRY_TOKENS=49152
# Map-reduce: windows larger than DIGEST_MAP_ITEMS picks are split into
# size-balanced chunks (≤ ITEMS items and ≤ CHARS chars each), partial-summarized
# (≤ MAP_TOKENS out per chunk), then synthesized in one final call.
DIGEST_MAP_ITEMS=30
DIGEST_MAP_CHARS=45000
DIGEST_MAP_TOKENS=8000
# Minutes between collection passes
COLLECT_INTERVAL_MIN=30
# Analysis throughput: articles per pass + concurrent LLM calls within a pass.
# Raise to drain a backlog faster (e.g. ANALYZE_BATCH=200, ANALYZE_CONCURRENCY=5);
# lower if the provider rate-limits.
ANALYZE_BATCH=50
ANALYZE_CONCURRENCY=3

# ─── X (Twitter) ────────────────────────────────────────────────────
# 권장: 내 X 계정 쿠키로 직접 수집 (브라우저·브리지 불필요).
# x.com 로그인 → 개발자도구 → Application → Cookies → https://x.com 에서 복사:
X_AUTH_TOKEN=
X_CT0=
# (대안) RSS 브리지: "{handle}" 템플릿 또는 베이스 URL. 쿠키가 없을 때만 사용됨.
# X_RSS_BRIDGE=https://xcancel.com/{handle}/rss

# ─── Telegram (공개 채널 배치 수집, 내 계정 세션) ───────────────────
# api_id / api_hash: https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 1회 로컬 로그인으로 생성: `npm run telegram:login` → 출력된 문자열을 여기에
TELEGRAM_SESSION=

# ─── Discord (optional) ─────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ─── Authenticated sources (Substack paid / Naver Premium / Fanding / X) ────
# No passwords here. You log in yourself in a real browser via:
#     npm run login -- --source=<sourceId>
# Only the logged-in session is saved to sessions/<...>.json (git-ignored).

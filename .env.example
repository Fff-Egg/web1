# ─── Database (MySQL) ───────────────────────────────────────────────
# Drizzle/mysql2 connection string
DATABASE_URL=mysql://user:password@localhost:3306/feed_watch

# ─── Server ─────────────────────────────────────────────────────────
PORT=3000
# Comma-separated origins allowed for the API (dev client runs on 5173)
CLIENT_ORIGIN=http://localhost:5173
# Protect the dashboard and tRPC API with browser-native HTTP Basic Auth.
# APP_USERNAME defaults to "admin" when omitted. Always set APP_PASSWORD on Railway.
APP_USERNAME=admin
APP_PASSWORD=

# ─── Analysis LLM ───────────────────────────────────────────────────
# Two ways to power auto-analysis. Pick ONE (manual mode needs neither):
#
# (A) Anthropic (Claude):
ANTHROPIC_API_KEY=
#
# (B) Any OpenAI-compatible endpoint — Groq (free tier) / OpenRouter /
#     DeepInfra / Together / local Ollama. Set all three:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile      # or e.g. qwen-2.5-32b
#
# For DeepSeek, Flash can handle filtering, map compression and final synthesis.
# (The web Settings page may override these values.)
# Set all three to the released text model ID confirmed in DeepSeek's console.
# V4.1 Flash's official model ID is deepseek-flash (2026-09-10):
# LLM_MODEL=deepseek-flash
# FILTER_MODEL=deepseek-flash
# ANALYSIS_MODEL=deepseek-flash
# DeepSeek V4/V4.1 stage policy: filter/map/emergency fallback = thinking
# OFF, final Flash or Pro digest = thinking ON. Avoid a global thinking override;
# per-call stage policy wins so Flash cannot accidentally become expensive.
# Settings can independently override Thinking for filter, map, and final stages.
# At api.deepseek.com this policy follows the endpoint, regardless of model name.

# ─── Collection / scheduling ────────────────────────────────────────
# Day boundary + main digest hour (KST). Date D = [(D-1) HH:00, D HH:00).
# This run generates the boundary digest, sweeps the WHOLE day window, and
# refreshes the filter memo.
DIGEST_HOUR=7
# Second (midday) digest hour (KST). Splits the day window into two slots; may sit
# before OR after DIGEST_HOUR (e.g. boundary 07 + midday 17). Digest ONLY (no sweep).
DIGEST_MIDDAY_HOUR=17
# Digest synthesis output cap (tokens). Lower if the provider rejects it.
DIGEST_MAX_TOKENS=8192
# Final DeepSeek uses thinking by default. Set 0 for a non-thinking default;
# an explicit web Thinking selection takes precedence. Thinking + prose share max_tokens, so
# the app raises the final cap to at least 49,152. This is a cap, not fixed usage.
DIGEST_FINAL_THINKING=1
DIGEST_FINAL_THINKING_TOKENS=49152
# When these new vars are absent, legacy DIGEST_PRO_THINKING / _TOKENS still apply.
# Final synthesis runs once; on failure, use the map settings (default OFF) once.
# The same model ID is allowed only for this explicit thinking ON -> OFF fallback.
# If that also fails, do not save a partial report or retry indefinitely.
# Map-reduce: windows larger than DIGEST_MAP_ITEMS picks are split into
# size-balanced chunks (≤ ITEMS items and ≤ CHARS chars each), partial-summarized
# (≤ MAP_TOKENS out per chunk), then synthesized in one final call.
DIGEST_MAP_ITEMS=30
DIGEST_MAP_CHARS=45000
DIGEST_MAP_TOKENS=8000
# Full-article reading: no extra environment variables are required.
# Collected text up to 12,000 characters is passed intact; longer text is read
# in lossless chunks by the map model and cached for reuse in later digests.
# Old FILTER_BODY_CHARS / DIGEST_ITEM_CHARS / MAX_BODY_CHARS are no longer used.
# The first reading of a long article adds LLM calls; unchanged cached readings
# add none. Model, Thinking or summary-instruction changes invalidate this cache.
# Minutes between collection passes
COLLECT_INTERVAL_MIN=15
# Analysis throughput: articles per pass + concurrent LLM calls within a pass.
# Raise to drain a backlog faster (e.g. ANALYZE_BATCH=200, ANALYZE_CONCURRENCY=5);
# lower if the provider rate-limits.
ANALYZE_BATCH=50
ANALYZE_CONCURRENCY=3
# Keep collection running, but defer automatic per-article LLM analysis during
# DeepSeek's KST peak-price windows (10~13, 15~19). At 13:00/19:00 the server
# drains oldest pending rows in repeated batches. Set 0 only to disable.
ANALYSIS_AVOID_PEAK=1
ANALYSIS_DRAIN_MAX_ROUNDS=20

# ─── X (Twitter) ────────────────────────────────────────────────────
# 권장: 내 X 계정 쿠키로 직접 수집 (브라우저·브리지 불필요).
# x.com 로그인 → 개발자도구 → Application → Cookies → https://x.com 에서 복사:
X_AUTH_TOKEN=
X_CT0=
# (대안) RSS 브리지: "{handle}" 템플릿 또는 베이스 URL. 쿠키가 없을 때만 사용됨.
# X_RSS_BRIDGE=https://xcancel.com/{handle}/rss

# ─── Telegram (공개 채널 배치 수집, 내 계정 세션) ───────────────────
# api_id / api_hash: https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# 1회 로컬 로그인으로 생성: `npm run telegram:login` → 출력된 문자열을 여기에
TELEGRAM_SESSION=

# ─── Discord (optional) ─────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ─── Authenticated sources (Substack paid / Naver Premium / Fanding / X) ────
# No passwords here. You log in yourself in a real browser via:
#     npm run login -- --source=<sourceId>
# Only the logged-in session is saved to sessions/<...>.json (git-ignored).

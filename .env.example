# ─── Database (MySQL) ───────────────────────────────────────────────
# Drizzle/mysql2 connection string
DATABASE_URL=mysql://user:password@localhost:3306/feed_watch

# ─── Server ─────────────────────────────────────────────────────────
PORT=3000
# Comma-separated origins allowed for the API (dev client runs on 5173)
CLIENT_ORIGIN=http://localhost:5173

# ─── Analysis LLM ───────────────────────────────────────────────────
# Two ways to power auto-analysis. Pick ONE (manual mode needs neither):
#
# (A) Anthropic (Claude):
ANTHROPIC_API_KEY=
#
# (B) Any OpenAI-compatible endpoint — Groq (free tier) / OpenRouter /
#     DeepInfra / Together / local Ollama. Set all three:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile      # or e.g. qwen-2.5-32b
#
# Per-pass model override (optional). Defaults: Claude haiku/opus, or LLM_MODEL
# when an OpenAI-compatible endpoint is configured.
# FILTER_MODEL=
# ANALYSIS_MODEL=

# ─── Collection / scheduling ────────────────────────────────────────
# Hour (KST, 0-23) at which the evening digest is generated
DIGEST_HOUR=21
# Minutes between collection passes
COLLECT_INTERVAL_MIN=30

# ─── X (Twitter) ────────────────────────────────────────────────────
# Set to enable API path (e.g. "twitterapi" / "x"); leave empty to fall back to session scraping
X_API_PROVIDER=
X_API_KEY=

# ─── Discord (optional) ─────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ─── Authenticated sources (Substack paid / Naver Premium / Fanding / X) ────
# No passwords here. You log in yourself in a real browser via:
#     npm run login -- --source=<sourceId>
# Only the logged-in session is saved to sessions/<...>.json (git-ignored).

# ─── Database (MySQL) ───────────────────────────────────────────────
# Drizzle/mysql2 connection string
DATABASE_URL=mysql://user:password@localhost:3306/feed_watch

# ─── Server ─────────────────────────────────────────────────────────
PORT=3000
# Comma-separated origins allowed for the API (dev client runs on 5173)
CLIENT_ORIGIN=http://localhost:5173

# ─── Claude / Anthropic ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Cheap model for the 1st-pass relevance filter
FILTER_MODEL=claude-haiku-4-5-20251001
# Strong model for 2nd-pass deep analysis
ANALYSIS_MODEL=claude-opus-4-8

# ─── Collection / scheduling ────────────────────────────────────────
# Hour (KST, 0-23) at which the evening digest is generated
DIGEST_HOUR=21
# Minutes between collection passes
COLLECT_INTERVAL_MIN=30

# ─── X (Twitter) ────────────────────────────────────────────────────
# Set to enable API path (e.g. "twitterapi" / "x"); leave empty to fall back to session scraping
X_API_PROVIDER=
X_API_KEY=

# ─── Discord (optional) ─────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# ─── Authenticated sources (Substack paid / Naver Premium / Fanding / X) ────
# No passwords here. You log in yourself in a real browser via:
#     npm run login -- --source=<sourceId>
# Only the logged-in session is saved to sessions/<...>.json (git-ignored).

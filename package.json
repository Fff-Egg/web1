{
  "name": "feed-watch-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Feed Watch Dashboard — multi-source feed collection, investment analysis, and daily digest",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc -b && vite build",
    "build:demo": "cross-env VITE_STATIC_DEMO=true BASE_PATH=/web1/ vite build",
    "deploy:pages": "npm run build:demo && gh-pages -d dist -b gh-pages -t",
    "preview": "vite preview",
    "start": "npm run db:migrate && tsx src/server/index.ts",
    "server": "tsx src/server/index.ts",
    "worker:collect": "tsx src/server/workers/collect.ts",
    "worker:analyze": "tsx src/server/workers/analyze.ts",
    "worker:digest": "tsx src/server/workers/digest.ts",
    "login": "tsx src/server/auth/login.ts",
    "telegram:login": "tsx src/server/telegram/login.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/server/db/seed.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@tanstack/react-query": "^5.62.0",
    "@the-convocation/twitter-scraper": "^0.22.3",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "marked": "^15.0.0",
    "mysql2": "^3.11.0",
    "node-cron": "^4.6.0",
    "playwright": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rss-parser": "^3.13.0",
    "superjson": "^2.2.1",
    "telegram": "^2.26.22",
    "tsx": "^4.19.0",
    "ws": "^8.21.0",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
